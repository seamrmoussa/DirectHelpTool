{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "directhelptool",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist/DirectHelpTool/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
